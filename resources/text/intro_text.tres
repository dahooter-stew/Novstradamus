[ext_resource type="Script" uid="uid://wks6p62eg21q" path="res://resources/text/narration_text.gd" id="1_2ex1q"]

[resource]
script = ExtResource("1_2ex1q")
text_lines_array = Array[String](["November 19, 1972", "Class is getting boring, so might as well get a journal entry in.", "It’s been a few weeks since Prime Minister Vlad rolled out his mask policy.", "It hasn’t gotten any better, that’s for sure.", "I swear there’s more and more Surveillors every week.", "Can’t help but miss Friday night outs with Miguel and Alexandria. I hope they’re coping better than me, at least.", "Things have to change one way or another.", "I think I remember Ms. Veda and Ms. Sol talking about the Surveillors on campus going to the main building basement after curfew.", "That good-for-nothing Chancellor Dallan must be hiding something really important there.", "I’ve gotten pretty used to my mask-shifting at this point. Those Surveillors wouldn’t even know what hit them.", "Just you wait Vlad, I’m bringing you down once and for all."])
metadata/_custom_type_script = "uid://wks6p62eg21q"
